# Backend server configuration
PORT=5000
NODE_ENV=development

# MongoDB configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/taskmanager?retryWrites=true&w=majority

# JWT configuration
JWT_SECRET=78df0fc42a1fedef770083dcabff2e1bef54a3aa09d79a8868cfeba7bf62f246
ADMIN_INVITE_TOKEN=1234567

# Redis configuration (optional - will work without Redis)
REDIS_URL=redis://localhost:6379

# Email configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_SECURE=false

# Frontend configuration
CLIENT_URL=http://localhost:5173,https://yourdomain.com

# File upload configuration
MAX_FILE_SIZE=25MB
UPLOAD_DIR=uploads

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging configuration
LOG_LEVEL=info
LOG_DIR=logs
